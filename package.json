{
  "name": "active-window-sessions",
  "version": "0.1.2",
  "description": "Turn active-win and get-windows readings into time segments per app and website: merges gaps, drops blips and respects idle time.",
  "keywords": [
    "active-win",
    "active-window",
    "get-windows",
    "app usage tracker",
    "track time spent on apps",
    "screen time tracker mac",
    "time-tracking",
    "app-usage",
    "activity-tracking",
    "idle",
    "sessions",
    "electron"
  ],
  "homepage": "https://oss.saimulislam.com/active-window-sessions/",
  "bugs": {
    "url": "https://github.com/saimulft/active-window-sessions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saimulft/active-window-sessions.git"
  },
  "license": "MIT",
  "author": "Saimul Islam (https://github.com/saimulft)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./macos": {
      "types": "./dist/macos.d.ts",
      "default": "./dist/macos.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "eslint . && npm run lint:names",
    "lint:names": "ls-lint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "peerDependencies": {
    "get-windows": ">=9"
  },
  "peerDependenciesMeta": {
    "get-windows": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ls-lint/ls-lint": "^2.3.2",
    "@types/node": "^20.19.43",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
